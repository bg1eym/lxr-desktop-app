{
  "name": "lxr02-emu-web",
  "private": true,
  "version": "0.1.0",
  "description": "LXR-02 Emu (unofficial): the LXR-02 firmware in the browser",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "wasm": "cmake -S ../emu -B ../build/emu-wasm -DCMAKE_TOOLCHAIN_FILE=\"$PWD/../emu/cmake/wasi-clang.cmake\" -DCMAKE_BUILD_TYPE=Release && cmake --build ../build/emu-wasm -j && cp ../build/emu-wasm/lxr_emu.wasm public/",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
